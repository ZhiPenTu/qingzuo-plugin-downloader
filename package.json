{
  "name": "@commerce/plugin-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.downloader",
    "title": "文件下载器",
    "description": "检测公开下载链接的断点续传能力，使用多线程加速并在重启后继续未完成任务",
    "category": "文件工具",
    "api": "^1.8.0",
    "ui": "ui/index.html",
    "releaseNotes": "首个版本：支持下载能力检测、多线程下载、全局保存位置、任务暂停与重启续传。",
    "permissions": {
      "downloads": "manage"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs",
    "test:market": "node tests/market.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.8.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
